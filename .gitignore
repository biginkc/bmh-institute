# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]

# Claude Code per-user settings
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/

# Supabase CLI local cache
supabase/.temp/

# Scratch / sample data
/tmp/

# Playwright E2E artefacts
/e2e/.auth/
/e2e-prod/.auth/
/playwright-report/
/test-results/
/playwright/.cache/

# Uploaded content during dev (Supabase Storage mirrors should not leak in)
/content-uploads/
/.course-import-state/

# BMH course video assets — regenerable build outputs, not versioned (recipe lives in docs/course-production/shotlists)
# The exact pre-redesign poster bytes are the rollback point for the approved poster replacement.
course-assets/*
!course-assets/posters/
course-assets/posters/*
!course-assets/posters/redesign-history/
!course-assets/posters/redesign-history/*.webp
docs/course-production/oral-check-pilot-live-verification-receipt.json

# Character generation anchors ARE versioned. They are approved on-model
# reference stills passed as image refs to every future generation; without
# them new art drifts off-model and prompting cannot recover the look. They
# are not regenerable build output. Re-included by walking the path back in
# (a bare negation cannot reach inside an excluded parent directory), so new
# anchors can be `git add`ed normally — no -f required.
!course-assets/scenes/
course-assets/scenes/*
!course-assets/scenes/*/
course-assets/scenes/*/*
!course-assets/scenes/*/_anchors/
!course-assets/scenes/*/_anchors/**

# Scene generation logs hold the exact prompt used to produce each still.
# They ARE the regeneration recipe for scene art, so they are versioned.
!course-assets/scenes/*/_logs/
!course-assets/scenes/*/_logs/**
