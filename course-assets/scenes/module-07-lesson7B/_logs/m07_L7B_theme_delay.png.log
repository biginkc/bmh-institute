from PIL import Image
from pathlib import Path
import math

src = Path('$HOME/.codex/generated_images/019f34a1-503c-7462-8caa-ca27a215ec6c/ig_01996db9f8beac6e016a4aea3d0a748191948376ee72f07e05.png')
out = Path('course-assets/scenes/module-07-lesson7B/m07_L7B_theme_competition.png')

palette_hex = ['#111111', '#62B3F3', '#FF7A00', '#FFD23F', '#FFF7DE', '#FFFFFF']
palette = [tuple(int(h[i:i+2], 16) for i in (1, 3, 5)) for h in palette_hex]

im = Image.open(src).convert('RGB')
w, h = im.size
target_ratio = 16 / 9
current_ratio = w / h
if abs(current_ratio - target_ratio) > 1e-6:
    if current_ratio > target_ratio:
        new_w = int(round(h * target_ratio))
        left = (w - new_w) // 2
        im = im.crop((left, 0, left + new_w, h))
    else:
        new_h = int(round(w / target_ratio))
        top = (h - new_h) // 2
        im = im.crop((0, top, w, top + new_h))

im = im.resize((1600, 900), Image.Resampling.LANCZOS)
px = im.load()
for y in range(im.height):
    for x in range(im.width):
        r, g, b = px[x, y]
        best = min(palette, key=lambda c: (r - c[0]) ** 2 + (g - c[1]) ** 2 + (b - c[2]) ** 2)
        px[x, y] = best

out.parent.mkdir(parents=True, exist_ok=True)
im.save(out, format='PNG', optimize=True)
print(f'saved={out}')
print(f'source_size={Image.open(src).size}')
print(f'final_size={im.size}')
print(f'palette={palette_hex}')
