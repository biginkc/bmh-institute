const sharp = require('sharp');
const input = '$HOME/.codex/generated_images/019f34a1-5b91-7d31-b74c-009903722f15/ig_07c225f71c6d5b84016a4aea3ad5b481a0a16d097db9d206f8.png';
const output = 'course-assets/scenes/module-07-lesson7B/m07_L7B_theme_trust.png';
const palette = [
  [0x62, 0xB2, 0xEF], // cornflower blue
  [0xFF, 0x76, 0x00], // orange
  [0xFF, 0xD5, 0x0D], // yellow
  [0xFF, 0xF8, 0xCA], // cream
  [0xFF, 0xFF, 0xFF], // white
  [0x00, 0x00, 0x00], // black
];
const { data, info } = await sharp(input)
  .resize(1600, 900, { fit: 'fill' })
  .removeAlpha()
  .raw()
  .toBuffer({ resolveWithObject: true });
for (let i = 0; i < data.length; i += info.channels) {
  const r = data[i];
  const g = data[i + 1];
  const b = data[i + 2];
  let best = palette[0];
  let bestDistance = Infinity;
  for (const color of palette) {
    const dr = r - color[0];
    const dg = g - color[1];
    const db = b - color[2];
    const distance = dr * dr + dg * dg + db * db;
    if (distance < bestDistance) {
      bestDistance = distance;
      best = color;
    }
  }
  data[i] = best[0];
  data[i + 1] = best[1];
  data[i + 2] = best[2];
}
await sharp(data, { raw: { width: info.width, height: info.height, channels: info.channels } })
  .png({ compressionLevel: 9, palette: false })
  .toFile(output);
