    for x in range(img.width):
        r, g, b = pixels[x, y]
        # Keep very dark antialias pixels as outline to preserve drawing strength.
        nearest = min(
            palette,
            key=lambda c: (r - c[0]) ** 2 + (g - c[1]) ** 2 + (b - c[2]) ** 2,
        )
        pixels[x, y] = nearest

out.parent.mkdir(parents=True, exist_ok=True)
img.save(out, format='PNG', optimize=True)
print(out)
print(backup)
