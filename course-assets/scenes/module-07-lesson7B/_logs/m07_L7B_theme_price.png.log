exec
/bin/zsh -lc "node <<'NODE'
const sharp = await import('sharp');
const input = '$HOME/.codex/generated_images/019f34b0-853e-7f80-8917-1a1794b59e56/ig_0183e443d2811f74016a4aee0a54cc819f9375cb87e0d216aa.png';
const output = 'course-assets/scenes/module-07-lesson7B/m07_L7B_theme_price.png';
const palette = [
  [4, 4, 4],       // black linework
  [98, 179, 243],  // cornflower blue
  [247, 181, 0],   // golden yellow
  [255, 122, 0],   // orange
  [255, 210, 63],  // bright yellow
  [255, 248, 204], // cream
  [255, 255, 246], // warm white
];
const { data, info } = await sharp.default(input)
  .resize(1600, 900, { fit: 'fill' })
  .removeAlpha()
  .raw()
  .toBuffer({ resolveWithObject: true });
for (let i = 0; i < data.length; i += info.channels) {
  const r = data[i];
  const g = data[i + 1];
  const b = data[i + 2];
  let best = palette[0];
  let bestDist = Infinity;
  for (const color of palette) {
    const dr = r - color[0];
    const dg = g - color[1];
    const db = b - color[2];
    const dist = dr * dr + dg * dg + db * db;
    if (dist < bestDist) {
      bestDist = dist;
      best = color;
    }
  }
  data[i] = best[0];
  data[i + 1] = best[1];
  data[i + 2] = best[2];
}
await sharp.default(data, { raw: { width: info.width, height: info.height, channels: info.channels } })
  .png({ compressionLevel: 9, palette: false })
  .toFile(output);
console.log(output);
NODE" in $HOME/Sites/BMH apps/BMH Institute
