/bin/zsh -lc "python3 - <<'PY'
from PIL import Image
from pathlib import Path

src = Path('$HOME/.codex/generated_images/019f34a6-a42e-7ef1-8917-be8d0a6c96c5/ig_02bf70bd0f196053016a4aeb78a2c88192845620bf60c56b19.png')
dst = Path('course-assets/scenes/module-07-lesson7B/m07_L7B_theme_competition.png')
palette_hex = ['#111111', '#62B3F3', '#FF7A00', '#FFD23F', '#FFF7DE', '#FFFFFF']
palette = [tuple(int(h[i:i+2], 16) for i in (1, 3, 5)) for h in palette_hex]

img = Image.open(src).convert('RGB')
w, h = img.size
# Center-crop to 16:9 before resizing so the output is exact without stretching.
target_ratio = 16 / 9
ratio = w / h
if ratio > target_ratio:
    new_w = int(round(h * target_ratio))
    left = (w - new_w) // 2
    img = img.crop((left, 0, left + new_w, h))
elif ratio < target_ratio:
    new_h = int(round(w / target_ratio))
    top = (h - new_h) // 2
    img = img.crop((0, top, w, top + new_h))

img = img.resize((1600, 900), Image.Resampling.LANCZOS)
px = img.load()
for y in range(img.height):
    for x in range(img.width):
        r, g, b = px[x, y]
        # Bias near-light colors toward cream/white and dark antialiased edges toward ink.
        best = min(palette, key=lambda c: (r - c[0]) ** 2 + (g - c[1]) ** 2 + (b - c[2]) ** 2)
        px[x, y] = best

dst.parent.mkdir(parents=True, exist_ok=True)
img.save(dst, 'PNG', optimize=True)
print(f'source={src}')
print(f'source_size={w}x{h}')
print(f'output={dst}')
print('output_size=1600x900')
print(f'palette={palette_hex}')
PY" in $HOME/Sites/BMH apps/BMH Institute
