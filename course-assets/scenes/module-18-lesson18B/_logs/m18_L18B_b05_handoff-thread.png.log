from pathlib import Path
from PIL import Image
import math
src = Path('$HOME/.codex/generated_images/019f3b7b-9078-7502-8b69-a3728fdcdb8b/ig_07800fc585063ded016a4cab1155708191843d5a0ae12479a5.png')
out = Path('course-assets/scenes/module-18-lesson18B/m18_L18B_b05_handoff-thread.png')
out.parent.mkdir(parents=True, exist_ok=True)
img = Image.open(src).convert('RGB')
# Center-crop minimally to exact 16:9 before resizing.
w, h = img.size
target_ratio = 16 / 9
ratio = w / h
if ratio > target_ratio:
    new_w = round(h * target_ratio)
    left = (w - new_w) // 2
    img = img.crop((left, 0, left + new_w, h))
elif ratio < target_ratio:
    new_h = round(w / target_ratio)
    top = (h - new_h) // 2
    img = img.crop((0, top, w, top + new_h))
img = img.resize((1600, 900), Image.Resampling.LANCZOS)

palette = [
    (0x62, 0xb3, 0xf3),  # cornflower blue
    (0xff, 0xd2, 0x1a),  # yellow
    (0xff, 0x7a, 0x00),  # orange
    (0xff, 0xf6, 0xc8),  # cream
    (0xff, 0xff, 0xff),  # white
    (0x00, 0x00, 0x00),  # black
]

def srgb_dist(a, b):
    # Weighted distance keeps blacks and whites crisp while flattening color fills.
    dr = a[0] - b[0]
    dg = a[1] - b[1]
    db = a[2] - b[2]
    return 0.30 * dr * dr + 0.59 * dg * dg + 0.11 * db * db

pixels = img.load()
for y in range(img.height):
    for x in range(img.width):
        p = pixels[x, y]
        # Preserve strong line art as black.
        if p[0] < 55 and p[1] < 55 and p[2] < 55:
            pixels[x, y] = (0, 0, 0)
            continue
        # Preserve near-white fills.
        if p[0] > 242 and p[1] > 242 and p[2] > 235:
            pixels[x, y] = (255, 255, 255)
            continue
        pixels[x, y] = min(palette, key=lambda c: srgb_dist(p, c))
img.save(out, format='PNG', optimize=True)
print(out)
PY" in $HOME/Sites/BMH apps/BMH Institute
