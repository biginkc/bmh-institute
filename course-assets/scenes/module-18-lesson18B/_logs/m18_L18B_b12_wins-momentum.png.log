const fs = require('fs');
const sharp = require('sharp');

const input = '$HOME/.codex/generated_images/019f3b7b-907a-7802-abf0-dc9e0d8a6b66/ig_07afe43247f801dc016a4cab6c1de881a2bdae4382b5b161c7.png';
const output = 'course-assets/scenes/module-18-lesson18B/m18_L18B_b12_wins-momentum.png';
fs.mkdirSync('course-assets/scenes/module-18-lesson18B', { recursive: true });

const BLUE = [0x62, 0xb3, 0xf3];
const CREAM = [0xff, 0xf7, 0xde];
const BLACK = [0x11, 0x11, 0x11];
const YELLOW = [0xff, 0xd3, 0x10];
const ORANGE = [0xff, 0x7a, 0x00];
const WHITE = [0xff, 0xff, 0xff];
const palette = [BLUE, CREAM, BLACK, YELLOW, ORANGE, WHITE];

const cleanupSvg = Buffer.from("'`
<svg width="1600" height="900" viewBox="0 0 1600 900" xmlns="http://www.w3.org/2000/svg">
  <path d="M337 319 L356 342" stroke="#62b3f3" stroke-width="20" stroke-linecap="round"/>
  <path d="M375 305 L376 333" stroke="#62b3f3" stroke-width="20" stroke-linecap="round"/>
  <path d="M409 322 L392 348" stroke="#62b3f3" stroke-width="20" stroke-linecap="round"/>
</svg>`);

function nearest(r, g, b) {
  let best = palette[0];
  let bestDist = Infinity;
  for (const p of palette) {
    const dr = r - p[0];
    const dg = g - p[1];
    const db = b - p[2];
    const dist = dr * dr + dg * dg + db * db;
    if (dist < bestDist) {
      bestDist = dist;
      best = p;
    }
  }
  return best;
}

function classify(r, g, b) {
  const max = Math.max(r, g, b);
  const min = Math.min(r, g, b);
  const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;

  if (b > 150 && g > 95 && r < 160 && b - r > 55 && b - g > 20) return BLUE;
  if (lum < 105 && max - min < 90) return BLACK;
  if (r < 80 && g < 80 && b < 95) return BLACK;
  if (r > 242 && g > 242 && b > 238) return WHITE;
  if (r > 205 && g > 65 && g < 175 && b < 95) return ORANGE;
  if (r > 220 && g > 160 && b < 105) return YELLOW;
  if (r > 210 && g > 190 && b > 115) return CREAM;
  return nearest(r, g, b);
}

(async () => {
  const { data, info } = await sharp(input)
    .resize(1600, 900, { fit: '"'fill' })
    .composite([{ input: cleanupSvg, left: 0, top: 0 }])
    .removeAlpha()
    .raw()
    .toBuffer({ resolveWithObject: true });

  for (let i = 0; i < data.length; i += info.channels) {
    const p = classify(data[i], data[i + 1], data[i + 2]);
    data[i] = p[0];
    data[i + 1] = p[1];
    data[i + 2] = p[2];
  }

  await sharp(data, { raw: { width: info.width, height: info.height, channels: info.channels } })
    .png({ compressionLevel: 9, palette: false })
    .toFile(output);
})();
