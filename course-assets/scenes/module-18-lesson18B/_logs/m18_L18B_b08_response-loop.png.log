exec
/bin/zsh -lc "node - <<'NODE'
(async () => {
  const fs = require('fs');
  const path = require('path');
  const sharp = require('sharp');

  const src = '$HOME/.codex/generated_images/019f3b7b-907a-73e2-a400-5d58462445b4/ig_0bfaf7e3c766dd35016a4cab48317881a0b0d040896d468bc4.png';
  const out = 'course-assets/scenes/module-18-lesson18B/m18_L18B_b08_response-loop.png';
  const width = 1600;
  const height = 900;
  const palette = [
    [17, 17, 17],
    [98, 179, 243],
    [255, 122, 0],
    [255, 211, 16],
    [255, 247, 222],
    [255, 255, 255],
  ];

  fs.mkdirSync(path.dirname(out), { recursive: true });
  const { data } = await sharp(src)
    .resize(width, height, { fit: 'fill' })
    .removeAlpha()
    .raw()
    .toBuffer({ resolveWithObject: true });

  for (let i = 0; i < data.length; i += 3) {
    let best = palette[0];
    let bestDistance = Infinity;
    for (const color of palette) {
      const dr = data[i] - color[0];
      const dg = data[i + 1] - color[1];
      const db = data[i + 2] - color[2];
      const distance = dr * dr + dg * dg + db * db;
      if (distance < bestDistance) {
        bestDistance = distance;
        best = color;
      }
    }
    data[i] = best[0];
    data[i + 1] = best[1];
    data[i + 2] = best[2];
  }

  await sharp(data, { raw: { width, height, channels: 3 } })
    .png({ compressionLevel: 9, adaptiveFiltering: false })
    .toFile(out);
  console.log(out);
})().catch((error) => {
  console.error(error);
  process.exit(1);
});
