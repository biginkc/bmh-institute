/bin/zsh -lc "python3 - <<'PY'
from PIL import Image
from pathlib import Path

src = Path('$HOME/.codex/generated_images/019f3b7b-9077-7680-bb6a-7c8d4c21adbf/ig_0d34965740e9af56016a4cacb0376081a3b3036e0e37329fa4.png')
out = Path('course-assets/scenes/module-18-lesson18B/m18_L18B_b04_quality-check.png')
img = Image.open(src).convert('RGB').resize((1600, 900), Image.Resampling.LANCZOS)
palette = [
    (98, 179, 243),   # cornflower blue #62b3f3
    (255, 211, 0),    # yellow
    (255, 122, 0),    # orange
    (255, 245, 198),  # cream
    (0, 0, 0),        # black
]
px = img.load()
for y in range(img.height):
    for x in range(img.width):
        r, g, b = px[x, y]
        if r < 45 and g < 45 and b < 45:
            px[x, y] = (0, 0, 0)
            continue
        px[x, y] = min(palette, key=lambda c: (r-c[0])**2 + (g-c[1])**2 + (b-c[2])**2)
img.save(out, format='PNG', optimize=False)
print(out)
PY" in $HOME/Sites/BMH apps/BMH Institute
