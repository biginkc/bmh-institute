codex
The only practical local correction available is palette flattening. I’m preserving the composition, resizing to 1600x900, and mapping all pixels to the locked flat palette so the final asset does not carry the generator’s gradients.
hook: PreToolUse
hook: PreToolUse Completed
exec
/bin/zsh -lc "python3 - <<'PY'
from PIL import Image
from pathlib import Path

src = Path('$HOME/.codex/generated_images/019f3b7b-9077-7680-bb6a-7c8d4c21adbf/ig_0e06604c11eae3cc016a4cababfe9881a19bee23e51f02160b.png')
out = Path('course-assets/scenes/module-18-lesson18B/m18_L18B_b04_quality-check.png')
img = Image.open(src).convert('RGB').resize((1600, 900), Image.Resampling.LANCZOS)
# Locked course palette: background, yellow, orange, cream, white, black.
palette = [
    (98, 179, 243),   # cornflower blue #62b3f3
    (255, 211, 0),    # yellow
    (255, 122, 0),    # orange
    (255, 245, 198),  # cream
    (255, 255, 255),  # white
    (0, 0, 0),        # black
]
px = img.load()
width, height = img.size
for y in range(height):
    for x in range(width):
        r, g, b = px[x, y]
        # Keep dark linework crisp instead of letting antialiasing drift to orange/blue.
        if r < 45 and g < 45 and b < 45:
            px[x, y] = (0, 0, 0)
            continue
        nearest = min(palette, key=lambda c: (r-c[0])**2 + (g-c[1])**2 + (b-c[2])**2)
        px[x, y] = nearest
out.parent.mkdir(parents=True, exist_ok=True)
img.save(out, format='PNG', optimize=False)
print(out)
PY" in $HOME/Sites/BMH apps/BMH Institute
