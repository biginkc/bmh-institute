exec
/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
from PIL import Image

src = Path('$HOME/.codex/generated_images/019f3b7b-90fb-71b0-889e-0a4ab0872a4d/ig_0d5bbb3ac88b2796016a4cab580238819e817b8ac29fb57a42.png')
out = Path('course-assets/scenes/module-18-lesson18B/m18_L18B_b07_dual-handoff.png')
img = Image.open(src).convert('RGB')
img = img.resize((1600, 900), Image.Resampling.LANCZOS)

# Locked BMH course palette. The exact background key is forced below.
palette = [
    (0x62, 0xb3, 0xf3),  # cornflower blue
    (0xff, 0xd2, 0x00),  # yellow
    (0xff, 0x7a, 0x00),  # orange
    (0xff, 0xf1, 0xb8),  # cream
    (0xff, 0xfb, 0xea),  # warm white
    (0x08, 0x08, 0x08),  # black
]
blue = palette[0]
black = palette[-1]

px = img.load()
w, h = img.size
for y in range(h):
    for x in range(w):
        r, g, b = px[x, y]
        # Remove generated blue lighting variation and edge glow.
        if b > 145 and g > 105 and r < 135 and (b - r) > 55:
            px[x, y] = blue
            continue
        # Preserve strong line art.
        if r < 55 and g < 55 and b < 55:
            px[x, y] = black
            continue
        # Nearest locked palette color for flat fills.
        px[x, y] = min(
            palette,
            key=lambda c: (r - c[0]) ** 2 + (g - c[1]) ** 2 + (b - c[2]) ** 2,
        )

out.parent.mkdir(parents=True, exist_ok=True)
img.save(out, 'PNG', optimize=True)
print(out)
PY" in $HOME/Sites/BMH apps/BMH Institute
