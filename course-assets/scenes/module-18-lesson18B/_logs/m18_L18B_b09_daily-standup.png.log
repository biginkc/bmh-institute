exec
/bin/zsh -lc "node <<'NODE'
const fs = require('fs');
const path = require('path');
const sharp = require('sharp');

const input = '$HOME/.Codex/generated_images/019f3b7b-9089-7e80-a5cd-9d1376f8bb30/ig_039d53f39da9ae8c016a4cabb6bdf881a2bb936a9e40921a29.png';
const output = 'course-assets/scenes/module-18-lesson18B/m18_L18B_b09_daily-standup.png';

const palette = {
  blue: [0x62, 0xb3, 0xf3],
  cream: [0xff, 0xf6, 0xcf],
  white: [0xff, 0xff, 0xff],
  yellow: [0xff, 0xd2, 0x17],
  orange: [0xff, 0x7a, 0x00],
  black: [0x00, 0x00, 0x00],
};

function distSq(a, b) {
  return (a[0]-b[0]) ** 2 + (a[1]-b[1]) ** 2 + (a[2]-b[2]) ** 2;
}

function setPixel(data, i, color) {
  data[i] = color[0];
  data[i + 1] = color[1];
  data[i + 2] = color[2];
  data[i + 3] = 255;
}

(async () => {
  fs.mkdirSync(path.dirname(output), { recursive: true });

  const { data, info } = await sharp(input)
    .resize(1600, 900, { fit: 'fill' })
    .ensureAlpha()
    .raw()
    .toBuffer({ resolveWithObject: true });

  for (let i = 0; i < data.length; i += 4) {
    const r = data[i];
    const g = data[i + 1];
    const b = data[i + 2];
    const px = [r, g, b];

    // Black outlines and hair. Pull gray antialiasing into black so labels remain impossible.
    if (r < 95 && g < 95 && b < 95) {
      setPixel(data, i, palette.black);
      continue;
    }

    // Flatten the whole background field and blue edge glow to the locked cornflower blue.
    if (b > 150 && g > 105 && r < 145 && b > r + 55) {
      setPixel(data, i, palette.blue);
      continue;
    }

    // Orange clothing.
    if (r > 185 && g > 70 && g < 175 && b < 85) {
      setPixel(data, i, palette.orange);
      continue;
    }

    // Yellow clothing and warm fills.
    if (r > 185 && g > 145 && b < 95) {
      setPixel(data, i, palette.yellow);
      continue;
    }

    // Cream cards, avatar circles, faces, and row bars.
    if (r > 190 && g > 175 && b > 125) {
      setPixel(data, i, palette.cream);
      continue;
    }

    // Last-resort nearest locked palette color. Keeps any antialias strays inside the palette.
    const choices = [palette.blue, palette.cream, palette.white, palette.yellow, palette.orange, palette.black];
    let best = choices[0];
    let bestDist = Infinity;
    for (const color of choices) {
      const d = distSq(px, color);
      if (d < bestDist) {
        bestDist = d;
        best = color;
      }
    }
    setPixel(data, i, best);
  }

  await sharp(data, { raw: { width: info.width, height: info.height, channels: 4 } })
    .png({ compressionLevel: 9, adaptiveFiltering: false })
    .toFile(output);

  const meta = await sharp(output).metadata();
  console.log(JSON.stringify({ output, width: meta.width, height: meta.height, format: meta.format, size: fs.statSync(output).size }, null, 2));
})();
NODE" in $HOME/Sites/BMH apps/BMH Institute
