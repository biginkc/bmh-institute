from PIL import Image, ImageDraw, ImageFont
from pathlib import Path
paths = [
Path('$HOME/.codex/generated_images/019f459b-7763-7170-aeb0-945a599e63fb/ig_0ac6e3844e032b5a016a4f4333299c8197b7788c97f2bdd689.png'),
