Path('$HOME/.codex/generated_images/019f459b-7762-77a1-b039-ca4071bd19d5/ig_0dde674d8b3b0660016a4f432f67c08197b7efd1ef503fc761.png'),
Path('$HOME/.codex/generated_images/019f459b-7762-7f70-9bed-3bd317530c46/ig_0cbf1791a027aacc016a4f4333940881909af0e1c5b7186d1e.png'),
Path('$HOME/.codex/generated_images/019f459b-7768-73b2-a703-768906a19ff0/ig_0c1d7969251c23b1016a4f4326e29c8195b972be0ba0c4f535.png'),
]
thumb_w, thumb_h = 480, 270
pad = 28
label_h = 40
sheet = Image.new('RGB', (thumb_w*2 + pad*3, (thumb_h+label_h)*3 + pad*4), '#62b3f3')
d = ImageDraw.Draw(sheet)
for idx, path in enumerate(paths, 1):
    im = Image.open(path).convert('RGB')
    im.thumbnail((thumb_w, thumb_h), Image.Resampling.LANCZOS)
    cell_x = pad + ((idx-1) % 2) * (thumb_w + pad)
    cell_y = pad + ((idx-1) // 2) * (thumb_h + label_h + pad)
    x = cell_x + (thumb_w - im.width)//2
    y = cell_y
    sheet.paste(im, (x, y))
    d.text((cell_x, cell_y + thumb_h + 8), f'candidate {idx}', fill='black')
out = Path('/private/tmp/lesson18a_b12_candidates.png')
sheet.save(out)
print(out)
PY" in $HOME/Sites/BMH apps/BMH Institute
