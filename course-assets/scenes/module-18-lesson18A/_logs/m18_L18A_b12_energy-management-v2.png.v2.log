/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
from PIL import Image

src = Path('$HOME/.codex/generated_images/019f45a1-2a21-70e2-9356-54c61359c266/ig_060554737bb4791c016a4f446667a08193802be82cca36241d.png')
out = Path('course-assets/scenes/module-18-lesson18A/m18_L18A_b12_energy-management-v2.png')
img = Image.open(src).convert('RGB')

# Center-crop very slightly to exact 16:9, then resize to the requested course size.
w, h = img.size
target_ratio = 16 / 9
current_ratio = w / h
if current_ratio > target_ratio:
    new_w = round(h * target_ratio)
    left = (w - new_w) // 2
    img = img.crop((left, 0, left + new_w, h))
elif current_ratio < target_ratio:
    new_h = round(w / target_ratio)
    top = (h - new_h) // 2
    img = img.crop((0, top, w, top + new_h))
img = img.resize((1600, 900), Image.Resampling.LANCZOS)

palette_colors = [
    (98, 179, 243),   # cornflower blue #62b3f3
    (255, 210, 63),   # yellow #FFD23F
    (255, 122, 0),    # orange
    (255, 247, 222),  # cream #FFF7DE
    (255, 255, 255),  # white
    (0, 0, 0),        # black
]

# Build a palette image for no-dither quantization. Keep exact locked colors.
pal = Image.new('P', (1, 1))
flat_palette = []
for color in palette_colors:
    flat_palette.extend(color)
flat_palette.extend([0, 0, 0] * (256 - len(palette_colors)))
pal.putpalette(flat_palette)

# No dithering: avoids texture and keeps course-style flat color islands.
quantized = img.quantize(palette=pal, dither=Image.Dither.NONE).convert('RGB')

# Normalize the whole border and large blue field exactly to canonical blue.
pix = quantized.load()
for y in range(quantized.height):
    for x in range(quantized.width):
        r, g, b = pix[x, y]
        if (r, g, b) == (98, 179, 243):
            pix[x, y] = (98, 179, 243)

out.parent.mkdir(parents=True, exist_ok=True)
quantized.save(out, format='PNG')
print(out)
PY" in $HOME/Sites/BMH apps/BMH Institute
