from pathlib import Path
from PIL import Image
import math

src = Path('$HOME/.codex/generated_images/019f45a1-2a21-70e2-9356-54c61359c266/ig_060554737bb4791c016a4f446667a08193802be82cca36241d.png')
out = Path('course-assets/scenes/module-18-lesson18A/m18_L18A_b12_energy-management-v2.png')
img = Image.open(src).convert('RGB')

w, h = img.size
target_ratio = 16 / 9
current_ratio = w / h
if current_ratio > target_ratio:
    new_w = round(h * target_ratio)
    left = (w - new_w) // 2
    img = img.crop((left, 0, left + new_w, h))
elif current_ratio < target_ratio:
    new_h = round(w / target_ratio)
    top = (h - new_h) // 2
    img = img.crop((0, top, w, top + new_h))
img = img.resize((1600, 900), Image.Resampling.LANCZOS)

BLUE = (98, 179, 243)
YELLOW = (255, 210, 63)
ORANGE = (255, 122, 0)
CREAM = (255, 247, 222)
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
foreground_palette = [YELLOW, ORANGE, CREAM, WHITE, BLACK]

def dist2(a, b):
    return sum((a[i] - b[i]) ** 2 for i in range(3))

def blue_field(c):
    r, g, b = c
    return b >= 170 and g >= 125 and r <= 170 and b >= r + 35 and g >= r + 15

def map_color(c):
    r, g, b = c
    if blue_field(c):
        return BLUE
    # Preserve strong black outlines and dark chair/monitor legs.
    if max(c) < 80 or (r + g + b) < 170:
        return BLACK
    # Keep orange objects distinct from yellow shirt.
    if r >= 190 and g <= 175 and b <= 90:
        return ORANGE
    if r >= 190 and g > 150 and b <= 120:
        return YELLOW
    # Grey or warm light surfaces should become allowed paper/screen colors, never blue.
    if abs(r - g) < 35 and abs(g - b) < 35:
        if (r + g + b) / 3 > 230:
            return WHITE
        if (r + g + b) / 3 > 110:
            return CREAM
    return min(foreground_palette, key=lambda p: dist2(c, p))

out_img = Image.new('RGB', img.size)
out_pix = out_img.load()
in_pix = img.load()
for y in range(img.height):
    for x in range(img.width):
        out_pix[x, y] = map_color(in_pix[x, y])

out.parent.mkdir(parents=True, exist_ok=True)
out_img.save(out, format='PNG')
print(out)
PY" in $HOME/Sites/BMH apps/BMH Institute
