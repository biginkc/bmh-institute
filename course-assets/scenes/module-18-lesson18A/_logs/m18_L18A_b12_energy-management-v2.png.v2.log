/bin/zsh -lc "python3 - <<'PY'
from collections import Counter
from pathlib import Path
from PIL import Image

p = Path('course-assets/scenes/module-18-lesson18A/m18_L18A_b12_energy-management-v2.png')
img = Image.open(p).convert('RGB')
BLACK = (0, 0, 0)

def smooth_nonblack(src, radius=2):
    w, h = src.size
    in_pix = src.load()
    out = src.copy()
    out_pix = out.load()
    for y in range(h):
        y0, y1 = max(0, y - radius), min(h - 1, y + radius)
        for x in range(w):
            c = in_pix[x, y]
            if c == BLACK:
                continue
            x0, x1 = max(0, x - radius), min(w - 1, x + radius)
            counts = Counter()
            for yy in range(y0, y1 + 1):
                for xx in range(x0, x1 + 1):
                    nc = in_pix[xx, yy]
                    if nc "'!= BLACK:
                        counts[nc] += 1
            if counts:
                top_color, top_count = counts.most_common(1)[0]
                if top_count >= 8:
                    out_pix[x, y] = top_color
    return out

for _ in range(2):
    img = smooth_nonblack(img, radius=2)

img.save(p, format='"'PNG')
print(p)
PY" in $HOME/Sites/BMH apps/BMH Institute
