from pathlib import Path

src = Path('$HOME/.codex/generated_images/019f45a1-2a1f-7b31-8d49-26bab487b159/ig_079c0055a4c6408a016a4f45747d248197983eb451c272eb96.png')
dest = Path('course-assets/scenes/module-18-lesson18A/m18_L18A_b04_first-call-block-v2.png')
palette = [
    (98, 179, 243),   # #62B3F3 cornflower blue
    (255, 210, 63),   # #FFD23F yellow
    (255, 132, 0),    # orange
    (255, 247, 222),  # #FFF7DE cream
    (255, 255, 255),  # white
    (0, 0, 0),        # black
]

img = Image.open(src).convert('RGB').resize((1600, 900), Image.Resampling.LANCZOS)
pix = img.load()
w, h = img.size
for y in range(h):
    for x in range(w):
        r, g, b = pix[x, y]
        # Keep very dark outlines and hair solid black.
        if r < 54 and g < 54 and b < 54:
            pix[x, y] = (0, 0, 0)
            continue
        # Generated antialias grays usually belong to outlines.
        if abs(r - g) < 12 and abs(g - b) < 12 and r < 150:
            pix[x, y] = (0, 0, 0)
            continue
        pix[x, y] = min(palette, key=lambda c: (r - c[0]) ** 2 + (g - c[1]) ** 2 + (b - c[2]) ** 2)

dest.parent.mkdir(parents=True, exist_ok=True)
img.save(dest, format='PNG', optimize=True)
print(dest)
