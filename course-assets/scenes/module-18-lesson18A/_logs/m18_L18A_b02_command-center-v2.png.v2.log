palette.extend([0, 0, 0] * (256 - len(palette_colors)))
palette_img.putpalette(palette)
flat = img.quantize(palette=palette_img, dither=Image.Dither.NONE).convert('RGB')
out.parent.mkdir(parents=True, exist_ok=True)
flat.save(out, format='PNG', optimize=True)
print(out)
