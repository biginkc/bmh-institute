exec
/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
from PIL import Image, ImageOps

src = Path('$HOME/.codex/generated_images/019f45a1-2a27-7123-b18d-0adf8330d66f/ig_07428fffc32b5aa1016a4f453ddc7c819385f00308587748f8.png')
out = Path('course-assets/scenes/module-18-lesson18A/m18_L18A_b03_research-prep-v2.png')
out.parent.mkdir(parents=True, exist_ok=True)

palette = {
    'blue': (0x62, 0xb3, 0xf3),
    'yellow': (0xff, 0xd2, 0x3f),
    'orange': (0xff, 0x7a, 0x00),
    'cream': (0xff, 0xf7, 0xde),
    'white': (0xff, 0xff, 0xff),
    'black': (0x00, 0x00, 0x00),
}

img = Image.open(src).convert('RGBA')
img = ImageOps.fit(img, (1600, 900), method=Image.Resampling.LANCZOS, centering=(0.5, 0.5))
px = img.load()

palette_values = list(palette.values())

def dist2(c, p):
    return (c[0]-p[0])**2 + (c[1]-p[1])**2 + (c[2]-p[2])**2

for y in range(img.height):
    for x in range(img.width):
        r, g, b, a = px[x, y]
        if a == 0:
            continue
        # Force the generated blue gradients into the exact course blue.
        if b >= 145 and g >= 120 and r <= 135 and (b - r) >= 55:
            px[x, y] = (*palette['blue'], a)
            continue
        # Preserve the course's heavy black linework.
        if max(r, g, b) <= 72:
            px[x, y] = (*palette['black'], a)
            continue
        # Flatten the main fills. These thresholds remove model-added shading.
        if r >= 210 and 70 <= g <= 175 and b <= 95:
            px[x, y] = (*palette['orange'], a)
            continue
        if r >= 210 and g >= 170 and b <= 135:
            px[x, y] = (*palette['yellow'], a)
            continue
        if r >= 225 and g >= 215 and b >= 185:
            # Keep the face/hands white and desk/cards cream.
            if min(r, g, b) >= 246:
                px[x, y] = (*palette['white'], a)
            else:
                px[x, y] = (*palette['cream'], a)
            continue
        # Any remaining off-palette antialias or generated color goes to nearest approved color.
        nr, ng, nb = min(palette_values, key=lambda p: dist2((r, g, b), p))
        px[x, y] = (nr, ng, nb, a)

img.save(out, 'PNG')
print(out)
print(f'{img.width}x{img.height}')
PY" in $HOME/Sites/BMH apps/BMH Institute
