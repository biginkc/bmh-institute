exec
/bin/zsh -lc "python3 - <<'PY'
from PIL import Image, ImageDraw, ImageFont
from pathlib import Path
paths=sorted(Path('$HOME/.codex/generated_images').glob('019f45a1-*/ig_*.png'), key=lambda p:p.stat().st_mtime, reverse=True)[:8]
thumbs=[]
for p in paths:
    im=Image.open(p).convert('RGB')
    im.thumbnail((360,210))
    canvas=Image.new('RGB',(380,250),'white')
    canvas.paste(im,((380-im.width)//2,0))
    ImageDraw.Draw(canvas).text((8,218),p.parent.name[-8:]+' '+p.name[:10],fill=(0,0,0))
    thumbs.append(canvas)
cols=2
rows=(len(thumbs)+cols-1)//cols
sheet=Image.new('RGB',(cols*380,rows*250),'white')
for i,t in enumerate(thumbs): sheet.paste(t,((i%cols)*380,(i//cols)*250))
out=Path('/tmp/m18_l18a_b05_candidates.jpg')
sheet.save(out,quality=90)
print(out)
for i,p in enumerate(paths,1): print(i,p)
PY" in $HOME/Sites/BMH apps/BMH Institute
