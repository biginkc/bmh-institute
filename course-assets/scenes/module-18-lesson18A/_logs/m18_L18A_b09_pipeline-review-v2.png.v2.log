from pathlib import Path
from PIL import Image
src = Path('course-assets/scenes/module-18-lesson18A/m18_L18A_b09_pipeline-review-v2.png')
out = Path('/tmp/m18_L18A_b09_pipeline-review-v2-flat.png')
img = Image.open(src).convert('RGB')
palette_colors = [
    (98, 179, 243),   # cornflower blue
    (255, 210, 63),   # yellow
    (255, 122, 0),    # orange
    (255, 247, 222),  # cream
    (255, 255, 255),  # white
    (0, 0, 0),        # black
]
pal = Image.new('P', (1, 1))
flat = []
for c in palette_colors:
    flat.extend(c)
flat.extend([0, 0, 0] * (256 - len(palette_colors)))
pal.putpalette(flat)
q = img.quantize(palette=pal, dither=Image.Dither.NONE).convert('RGB')
q.save(out, format='PNG', optimize=True)
print(out)
