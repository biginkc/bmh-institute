from PIL import Image
from collections import Counter, deque
p='course-assets/scenes/module-17/m17_L17_b10_wallet.png'
im=Image.open(p).convert('RGB')
W,H=im.size
BLUE=(98,179,243); GREEN=(86,177,82)
print('size', W, H)
colors=Counter(im.getdata())
print('colors', sorted((('#%02X%02X%02X'%c,n) for c,n in colors.items())))
pocket=im.crop((520,805,1080,900))
print('bottom_center_all_blue', all(px==BLUE for px in pocket.getdata()))
# count connected green components as a sanity check for three bills
pix=im.load(); visited=set(); comps=[]
for y in range(H):
    for x in range(W):
        if (x,y) in visited or pix[x,y]"'!=GREEN: continue
        q=[(x,y)]; visited.add((x,y)); minx=maxx=x; miny=maxy=y; area=0
        while q:
            cx,cy=q.pop(); area+=1; minx=min(minx,cx); maxx=max(maxx,cx); miny=min(miny,cy); maxy=max(maxy,cy)
            for nx,ny in ((cx+1,cy),(cx-1,cy),(cx,cy+1),(cx,cy-1)):
                if 0<=nx<W and 0<=ny<H and (nx,ny) not in visited and pix[nx,ny]==GREEN:
                    visited.add((nx,ny)); q.append((nx,ny))
        comps.append((area,minx,miny,maxx,maxy))
print('"'green_components', comps)
