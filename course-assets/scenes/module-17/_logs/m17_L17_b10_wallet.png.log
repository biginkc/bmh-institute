        if visited[idx] or not black(x,y):
            continue
        q=[(x,y)]
        visited[idx]=1
        pts=[]
        minx=maxx=x; miny=maxy=y
        while q:
            cx,cy=q.pop()
            pts.append((cx,cy))
            if cx<minx: minx=cx
            if cx>maxx: maxx=cx
            if cy<miny: miny=cy
            if cy>maxy: maxy=cy
            for nx,ny in ((cx+1,cy),(cx-1,cy),(cx,cy+1),(cx,cy-1)):
