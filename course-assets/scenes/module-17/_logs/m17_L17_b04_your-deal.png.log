from PIL import Image
from pathlib import Path

src = Path('$HOME/.codex/generated_images/019f495b-f68d-78e2-bc44-1f690b0a0644/ig_047857b1056beaa2016a5038af77408197a1d4aa214a9952c5.png')
out = Path('course-assets/scenes/module-17/m17_L17_b04_your-deal.png')
out.parent.mkdir(parents=True, exist_ok=True)

img = Image.open(src).convert('RGB')
# The generated aspect is close to 16:9. Fit removes the tiny edge excess cleanly.
img = ImageOps_fit = __import__('PIL.ImageOps', fromlist=['fit']).fit(img, (1600, 900), method=Image.Resampling.LANCZOS, centering=(0.5, 0.5))

palette_colors = [
    (0x62, 0xb3, 0xf3),  # locked cornflower blue background
    (0xff, 0xd2, 0x1a),  # yellow
    (0xff, 0x7a, 0x00),  # orange
    (0xff, 0xf6, 0xc8),  # cream
    (0xff, 0xff, 0xff),  # white
    (0x00, 0x00, 0x00),  # black
]

pix = img.load()
w, h = img.size
for y in range(h):
    for x in range(w):
        r, g, b = pix[x, y]
        best = min(palette_colors, key=lambda c: (r-c[0])**2 + (g-c[1])**2 + (b-c[2])**2)
        pix[x, y] = best

img.save(out, format='PNG', optimize=True)
print(out)
print(img.size)
print('colors', len(img.getcolors(maxcolors=10000000)))
print('palette', sorted(set(img.getdata())))
