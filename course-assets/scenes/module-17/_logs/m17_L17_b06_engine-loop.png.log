/bin/zsh -lc "python3 - <<'PY'
from PIL import Image
from pathlib import Path

src = Path('$HOME/.codex/generated_images/019f45ac-6398-7d23-9140-d8650b6a74ca/ig_01aeb39f2ef4c88e016a4f475450648195b5abab9dfdbb4426.png')
out = Path('course-assets/scenes/module-17/m17_L17_b06_engine-loop.png')
out.parent.mkdir(parents=True, exist_ok=True)

palette = [
    (0, 0, 0),
    (98, 179, 243),
    (255, 122, 0),
    (255, 211, 1),
    (255, 245, 199),
    (255, 255, 255),
]

img = Image.open(src).convert('RGB')
w, h = img.size
source_ratio = w / h
target_ratio = 16 / 9
if source_ratio > target_ratio:
    new_w = int(h * target_ratio)
    left = (w - new_w) // 2
    img = img.crop((left, 0, left + new_w, h))
elif source_ratio < target_ratio:
    new_h = int(w / target_ratio)
    top = (h - new_h) // 2
    img = img.crop((0, top, w, top + new_h))

img = img.resize((1600, 900), Image.Resampling.LANCZOS)
pixels = img.load()
for y in range(img.height):
    for x in range(img.width):
        r, g, b = pixels[x, y]
        nearest = min(palette, key=lambda c: (r - c[0]) ** 2 + (g - c[1]) ** 2 + (b - c[2]) ** 2)
        pixels[x, y] = nearest

img.save(out, format='PNG')
print(out)
