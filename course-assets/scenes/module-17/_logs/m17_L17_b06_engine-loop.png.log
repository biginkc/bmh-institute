from PIL import Image
from pathlib import Path
src = Path('$HOME/.codex/generated_images/019f45ac-6398-7d23-9140-d8650b6a74ca/ig_01aeb39f2ef4c88e016a4f475450648195b5abab9dfdbb4426.png')
out = Path('/private/tmp/m17_L17_b06_engine-loop-threshold.png')

BLACK = (0, 0, 0)
BLUE = (98, 179, 243)
ORANGE = (255, 122, 0)
YELLOW = (255, 211, 1)
CREAM = (255, 245, 199)
WHITE = (255, 255, 255)
PALETTE = [BLACK, BLUE, ORANGE, YELLOW, CREAM, WHITE]

img = Image.open(src).convert('RGB')
w, h = img.size
ratio = 16 / 9
if w / h > ratio:
    new_w = int(h * ratio)
    left = (w - new_w) // 2
    img = img.crop((left, 0, left + new_w, h))
elif w / h < ratio:
    new_h = int(w / ratio)
    top = (h - new_h) // 2
    img = img.crop((0, top, w, top + new_h))
img = img.resize((1600, 900), Image.Resampling.LANCZOS)

out_img = Image.new('RGB', img.size, BLUE)
in_px = img.load()
out_px = out_img.load()
for y in range(img.height):
    for x in range(img.width):
        r, g, b = in_px[x, y]
        # Solid black for outlines and dark antialias pixels.
        if r < 105 and g < 105 and b < 105:
            color = BLACK
        # Cornflower field and blue holes. Keep the background perfectly flat.
        elif b > 145 and g > 105 and r < 185 and (b - r) > 35:
            color = BLUE
        # Orange fills.
        elif r > 185 and 55 <= g < 165 and b < 115:
            color = ORANGE
        # Yellow fills.
        elif r > 185 and g >= 150 and b < 130:
            color = YELLOW
        # Bright neutral paper/dial interiors become solid white to avoid texture speckles.
        elif r > 165 and g > 155 and b > 130:
            color = WHITE
        else:
            color = min(PALETTE, key=lambda c: (r-c[0])**2 + (g-c[1])**2 + (b-c[2])**2)
        out_px[x, y] = color

out_img.save(out, format='PNG')
print(out)
