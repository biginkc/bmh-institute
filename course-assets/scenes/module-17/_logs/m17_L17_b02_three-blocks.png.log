exec
/bin/zsh -lc "python3 - <<'PY'
from PIL import Image
from pathlib import Path
src = Path('$HOME/.codex/generated_images/019f3baf-d761-7f00-8bc3-f4530d646ea0/ig_07b0b9d536d04238016a4cb95108808196afe3e8ebf3f52b69.png')
out = Path('course-assets/scenes/module-17/m17_L17_b02_three-blocks.png')
out.parent.mkdir(parents=True, exist_ok=True)
im = Image.open(src).convert('RGB').resize((1600, 900), Image.Resampling.LANCZOS)
blue = (98, 179, 243)      # #62b3f3
black = (0, 0, 0)
yellow = (255, 211, 1)
orange = (255, 122, 0)
cream = (255, 245, 199)
palette = [blue, black, yellow, orange, cream]
px = im.load()
for y in range(im.height):
    for x in range(im.width):
        r, g, b = px[x, y]
        # Keep the hand-drawn outline heavy and black, including antialiasing.
        if r < 85 and g < 85 and b < 85:
            px[x, y] = black
        # Background and blue halos become the exact plain blue field.
        elif b > 175 and g > 120 and r < 165 and b >= r + 45:
            px[x, y] = blue
        # Orange top block.
        elif r > 180 and 55 <= g < 180 and b < 120:
            px[x, y] = orange
        # Yellow middle block.
        elif r > 190 and g > 145 and b < 120:
            px[x, y] = yellow
        # Cream bottom block.
        elif r > 190 and g > 170 and b >= 105:
            px[x, y] = cream
        else:
            # Fallback to nearest locked color for edge pixels.
            px[x, y] = min(palette, key=lambda c: (r-c[0])**2 + (g-c[1])**2 + (b-c[2])**2)
im.save(out, format='PNG', optimize=True)
print(out)
PY" in $HOME/Sites/BMH apps/BMH Institute
