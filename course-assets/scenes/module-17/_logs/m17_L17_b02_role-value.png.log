from PIL import Image, ImageOps
import numpy as np
from pathlib import Path

src = Path('$HOME/.codex/generated_images/019f45a5-1fb7-7811-9e16-8469cb1ec85e/ig_0822721cbe9c7a83016a4f4570652c81958c28d96d7a28d7af.png')
dst = Path('course-assets/scenes/module-17/m17_L17_b02_role-value.png')
dst.parent.mkdir(parents=True, exist_ok=True)

img = Image.open(src).convert('RGB')
img = ImageOps.fit(img, (1600, 900), method=Image.Resampling.LANCZOS, centering=(0.5, 0.5))
arr = np.asarray(img, dtype=np.int16)

palette = np.array([
    [98, 179, 243],   # cornflower-blue #62b3f3
    [255, 213, 18],   # yellow
    [255, 126, 0],    # orange
    [255, 248, 213],  # cream
    [255, 255, 255],  # white
    [0, 0, 0],        # black
], dtype=np.int16)

# Weighted nearest palette: favors black for outlines and exact blue for background.
r, g, b = arr[..., 0], arr[..., 1], arr[..., 2]
flat = np.empty_like(arr)

black_mask = (r < 70) & (g < 70) & (b < 70)
blue_mask = (b > 145) & (g > 105) & (r < 170) & ~black_mask
orange_mask = (r > 190) & (g > 70) & (g < 170) & (b < 95) & ~black_mask & ~blue_mask
yellow_mask = (r > 200) & (g > 165) & (b < 110) & ~black_mask & ~blue_mask & ~orange_mask
cream_mask = (r > 200) & (g > 195) & (b > 145) & (b < 245) & ~black_mask & ~blue_mask & ~orange_mask & ~yellow_mask
white_mask = (r > 235) & (g > 235) & (b > 235) & ~black_mask & ~blue_mask & ~orange_mask & ~yellow_mask & ~cream_mask

remaining = ~(black_mask | blue_mask | orange_mask | yellow_mask | cream_mask | white_mask)
flat[blue_mask] = palette[0]
flat[yellow_mask] = palette[1]
flat[orange_mask] = palette[2]
flat[cream_mask] = palette[3]
flat[white_mask] = palette[4]
flat[black_mask] = palette[5]

if remaining.any():
    vals = arr[remaining]
    dists = ((vals[:, None, :] - palette[None, :, :]) ** 2).sum(axis=2)
    flat[remaining] = palette[dists.argmin(axis=1)]

out = Image.fromarray(flat.astype(np.uint8), 'RGB')
out.save(dst, format='PNG', optimize=True)
print(dst)
print(out.size)
print('colors', len(out.getcolors(maxcolors=1000000)))
