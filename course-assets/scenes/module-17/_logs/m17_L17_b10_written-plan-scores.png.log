exec
/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
from PIL import Image
import numpy as np

src = Path('$HOME/.codex/generated_images/019f45b3-3392-7831-a6ba-89c3724d312c/ig_0eb0a096fe04e380016a4f4902d0c881909e747817479fcb47.png')
out = Path('course-assets/scenes/module-17/m17_L17_b10_written-plan-scores.png')
img = Image.open(src).convert('RGB')

# Center-crop to 16:9, then resize to the required course frame.
w, h = img.size
target_ratio = 16 / 9
if w / h > target_ratio:
    new_w = round(h * target_ratio)
    left = (w - new_w) // 2
    img = img.crop((left, 0, left + new_w, h))
elif w / h < target_ratio:
    new_h = round(w / target_ratio)
    top = (h - new_h) // 2
    img = img.crop((0, top, w, top + new_h))
img = img.resize((1600, 900), Image.Resampling.LANCZOS)

palette = np.array([
    (0, 0, 0),        # black
    (98, 179, 243),   # cornflower blue
    (255, 122, 0),    # orange
    (255, 211, 1),    # yellow
    (255, 245, 199),  # cream
    (255, 255, 255),  # white
], dtype=np.int16)
arr = np.array(img, dtype=np.int16)
# Weighted distance keeps blue background from drifting and preserves black outlines.
weights = np.array([1.0, 1.0, 1.0], dtype=np.float32)
diff = arr[:, :, None, :] - palette[None, None, :, :]
dist = np.sum((diff.astype(np.float32) * weights) ** 2, axis=3)
idx = np.argmin(dist, axis=2)
quantized = palette[idx].astype(np.uint8)
Image.fromarray(quantized, mode='RGB').save(out)
print(out)
print(Image.open(out).size)
PY" in $HOME/Sites/BMH apps/BMH Institute
