/bin/zsh -lc "python - <<'PY'
from pathlib import Path
from PIL import Image

src = Path('$HOME/.codex/generated_images/019f45a5-1fb7-7bf0-889f-da4a1862d365/ig_06f7560b0687a89e016a4f458aeb6c819598ec2fefc99373e3.png')
out = Path('course-assets/scenes/module-17/m17_L17_b04_written-plan.png')
out.parent.mkdir(parents=True, exist_ok=True)
img = Image.open(src).convert('RGB')
img = img.resize((1600, 900), Image.Resampling.LANCZOS)

palette = [
    (0x62, 0xB3, 0xF3),  # cornflower blue
    (0xFF, 0xD3, 0x01),  # yellow
    (0xFF, 0x7A, 0x00),  # orange
    (0xFF, 0xF5, 0xC7),  # cream
    (0xFF, 0xFF, 0xFF),  # white
    (0x00, 0x00, 0x00),  # black
]

pix = img.load()
w, h = img.size
for y in range(h):
    for x in range(w):
        r, g, b = pix[x, y]
        # Keep line art confident after resize. The source has gray anti-aliasing
        # around black outlines that should collapse into the sticker outline.
        if r < 78 and g < 78 and b < 78:
            pix[x, y] = (0, 0, 0)
            continue
        best = min(palette, key=lambda c: (r - c[0]) ** 2 + (g - c[1]) ** 2 + (b - c[2]) ** 2)
        pix[x, y] = best

img.save(out)
