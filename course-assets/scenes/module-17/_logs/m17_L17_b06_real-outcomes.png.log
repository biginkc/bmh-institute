from pathlib import Path
from PIL import Image

src = Path('$HOME/.codex/generated_images/019f4968-6290-7e32-9177-d3026d251dfe/ig_043009b236eec833016a503c2a6b24819785860bb471420c9f.png')
out = Path('course-assets/scenes/module-17/m17_L17_b06_real-outcomes.png')
out.parent.mkdir(parents=True, exist_ok=True)

palette_colors = [
    (0x62, 0xb3, 0xf3),  # cornflower blue
    (0xff, 0xd2, 0x14),  # yellow
    (0xff, 0x84, 0x00),  # orange
    (0xff, 0xf8, 0xda),  # cream
    (0xff, 0xff, 0xff),  # white
    (0x00, 0x00, 0x00),  # black
]

img = Image.open(src).convert('RGBA')
background = Image.new('RGBA', img.size, (0x62, 0xb3, 0xf3, 255))
background.alpha_composite(img)
img = background.convert('RGB').resize((1600, 900), Image.Resampling.LANCZOS)

palette = Image.new('P', (1, 1))
flat_palette = []
for color in palette_colors:
    flat_palette.extend(color)
flat_palette.extend([0, 0, 0] * (256 - len(palette_colors)))
palette.putpalette(flat_palette)

quantized = img.quantize(palette=palette, dither=Image.Dither.NONE).convert('RGB')
quantized.save(out, format='PNG', optimize=True)
print(out)
PY" in $HOME/Sites/BMH apps/BMH Institute
