from pathlib import Path
from PIL import Image
from collections import Counter, deque

path = Path('course-assets/scenes/module-17/m17_L17_b05_strong-months.png')
img = Image.open(path).convert('RGB')
w, h = img.size
pixels = img.load()
counts = Counter(img.getdata())
BLUE = (0x62, 0xb3, 0xf3)
GREEN = (0x8f, 0xc2, 0x5e)

# Connected components of all non-background pixels.
seen = set()
components = []
for y in range(h):
    for x in range(w):
        if (x, y) in seen or pixels[x, y] == BLUE:
            continue
        q = deque([(x, y)])
        seen.add((x, y))
        minx = maxx = x
        miny = maxy = y
        n = 0
        has_green = False
        while q:
            cx, cy = q.popleft()
            n += 1
            minx = min(minx, cx); maxx = max(maxx, cx)
            miny = min(miny, cy); maxy = max(maxy, cy)
            if pixels[cx, cy] == GREEN:
                has_green = True
            for nx, ny in ((cx+1, cy), (cx-1, cy), (cx, cy+1), (cx, cy-1)):
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in seen and pixels[nx, ny] "'!= BLUE:
                    seen.add((nx, ny))
                    q.append((nx, ny))
        if n > 25:
            components.append((n, (minx, miny, maxx, maxy), has_green))

# Require overlay zone to be pure blue. Use broad lower center area.
zone = (500, 700, 1100, 899)
zone_pixels = [pixels[x, y] for y in range(zone[1], zone[3] + 1) for x in range(zone[0], zone[2] + 1)]
zone_blue_pct = zone_pixels.count(BLUE) / len(zone_pixels) * 100

print(f'"'path={path}')
print(f'size={w}x{h}')
print(f'color_count={len(counts)}')
print('colors=' + ', '.join(f'#{r:02x}{g:02x}{b:02x}:{n}' for (r,g,b), n in counts.most_common()))
print(f'non_blue_components={len(components)}')
for i, comp in enumerate(components, 1):
    print(f'component_{i}=pixels:{comp[0]} bbox:{comp[1]} has_green:{comp[2]}')
print(f'bottom_center_blue_pct={zone_blue_pct:.2f}')
print(f'green_pixels={counts[GREEN]}')
