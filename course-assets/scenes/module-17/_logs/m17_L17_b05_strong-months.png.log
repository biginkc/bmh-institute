from pathlib import Path
from PIL import Image
import math

src = Path('$HOME/.codex/generated_images/019f499a-3e35-7780-a8e7-99ed33c7ee40/ig_04d3bea833e988d4016a5048c2fc8c81959965704eacb5fa3e.png')
out = Path('course-assets/scenes/module-17/m17_L17_b05_strong-months.png')
img = Image.open(src).convert('RGB')

# Crop to exact 16:9 from center, then scale to the requested 1600x900.
w, h = img.size
target_ratio = 16 / 9
if w / h > target_ratio:
    new_w = int(h * target_ratio)
    left = (w - new_w) // 2
    img = img.crop((left, 0, left + new_w, h))
elif w / h < target_ratio:
    new_h = int(w / target_ratio)
    top = (h - new_h) // 2
    img = img.crop((0, top, w, top + new_h))
img = img.resize((1600, 900), Image.Resampling.LANCZOS)

BLUE = (0x62, 0xb3, 0xf3)
BLACK = (0, 0, 0)
GREEN = (0x8f, 0xc2, 0x5e)
YELLOW = (0xff, 0xd5, 0x16)
CREAM = (0xff, 0xf7, 0xd0)
WHITE = (255, 255, 255)
PALETTE = [BLUE, BLACK, GREEN, YELLOW, CREAM, WHITE]

def dist2(a, b):
    return sum((a[i] - b[i]) ** 2 for i in range(3))

def snap(px):
    r, g, b = px
    # Flatten all blue backdrop variations and soft object shadows to the locked background.
    if b >= 135 and g >= 120 and r <= 135 and b >= r + 35:
        return BLUE
    # Keep antialiased outline pixels confidently black.
    if max(px) <= 72 or (r < 95 and g < 95 and b < 95):
        return BLACK
    # Cash is the only green in the scene.
    if g >= r + 18 and g >= b + 12 and g >= 115:
        return GREEN
    # Arrow yellow.
    if r >= 185 and g >= 135 and b <= 115:
        return YELLOW
    # Envelope cream and interior highlights.
    if r >= 185 and g >= 170 and b >= 120:
        return CREAM
    nearest = min(PALETTE, key=lambda c: dist2(px, c))
    # Suppress residual shadow/halation pixels by preferring blue over dark non-black colors.
    if nearest == BLACK and max(px) > 105 and b >= g - 20:
        return BLUE
    return nearest

flat = Image.new('RGB', img.size)
flat.putdata([snap(px) for px in img.getdata()])
out.parent.mkdir(parents=True, exist_ok=True)
flat.save(out, format='PNG', optimize=True)
print(f'saved {out} from {src}')
print(f'size {flat.size[0]}x{flat.size[1]}')
print('colors', len(flat.getcolors(maxcolors=10000000)))
