/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
from PIL import Image

src = Path('$HOME/.codex/generated_images/019f496e-ec33-7122-8979-a656eb81bef3/ig_0162ab5b8b1371b4016a503de57aa88193a93e981fdf82aa9a.png')
out = Path('course-assets/scenes/module-17/m17_L17_b09_finish-line.png')
out.parent.mkdir(parents=True, exist_ok=True)

img = Image.open(src).convert('RGB')
# Center-crop to exact 16:9 before final resize.
w, h = img.size
target_ratio = 16 / 9
current_ratio = w / h
if current_ratio > target_ratio:
    new_w = int(round(h * target_ratio))
    left = (w - new_w) // 2
    img = img.crop((left, 0, left + new_w, h))
elif current_ratio < target_ratio:
    new_h = int(round(w / target_ratio))
    top = (h - new_h) // 2
    img = img.crop((0, top, w, top + new_h))
img = img.resize((1600, 900), Image.Resampling.LANCZOS)

palette_colors = [
    (0x00, 0x00, 0x00),  # black
    (0x62, 0xB3, 0xF3),  # cornflower blue
    (0xFF, 0x84, 0x00),  # orange
    (0xFF, 0xD2, 0x14),  # yellow
    (0xFF, 0xF8, 0xDA),  # cream
    (0xFF, 0xFF, 0xFF),  # white
]
# Use a fixed palette with no dithering so gradients and soft lighting collapse to flat fills.
pal = Image.new('P', (1, 1))
flat_palette = []
for c in palette_colors:
    flat_palette.extend(c)
flat_palette.extend([0, 0, 0] * (256 - len(palette_colors)))
pal.putpalette(flat_palette)
img = img.quantize(palette=pal, dither=Image.Dither.NONE).convert('RGB')
img.save(out, format='PNG', optimize=True)
print(out)
PY" in $HOME/Sites/BMH apps/BMH Institute
