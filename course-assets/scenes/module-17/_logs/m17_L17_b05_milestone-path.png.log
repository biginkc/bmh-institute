from pathlib import Path
from PIL import Image
import math
src = Path.home()/'.codex/generated_images/019f3d17-b07a-7b11-b985-269e7406d122/ig_0d4217bef5a4e739016a4d14f2e59c81908544c42b641f2942.png'
out = Path('/tmp/m17_L17_b05_milestone-path-flat-candidate.png')
img = Image.open(src).convert('RGB')
# Fit/crop center to 16:9 then resize to exact 1600x900.
w,h = img.size
target_ratio = 16/9
if w/h > target_ratio:
    new_w = round(h*target_ratio)
    left = (w-new_w)//2
    img = img.crop((left,0,left+new_w,h))
elif w/h < target_ratio:
    new_h = round(w/target_ratio)
    top = (h-new_h)//2
    img = img.crop((0,top,w,top+new_h))
img = img.resize((1600,900), Image.Resampling.LANCZOS)
# Locked flat palette. Use warm cream and saturated orange/yellow from current course refs.
palette = [
    (0x62,0xb3,0xf3),  # cornflower blue
    (0x00,0x00,0x00),  # black
    (0xff,0xd2,0x13),  # yellow
    (0xff,0x7a,0x00),  # orange
    (0xff,0xf4,0xc7),  # cream
    (0xff,0xff,0xff),  # white
]
# Slightly bias background-like blues to exact background so generated gradient disappears.
pix = img.load()
out_img = Image.new('RGB', img.size)
out_pix = out_img.load()
for y in range(img.height):
    for x in range(img.width):
        r,g,b = pix[x,y]
        # Strong blue background bucket, including pale anti-aliased blue gradient.
        if b > 150 and g > 115 and r < 170 and (b-r) > 35:
            out_pix[x,y] = palette[0]
            continue
        # Very dark ink bucket.
        if r < 55 and g < 55 and b < 55:
            out_pix[x,y] = palette[1]
            continue
        # Preserve black-ish outlines even if warmed by antialiasing.
        if r < 95 and g < 85 and b < 75:
            out_pix[x,y] = palette[1]
            continue
        # Orange bucket.
        if r > 170 and 55 <= g < 170 and b < 85:
            out_pix[x,y] = palette[3]
            continue
        # Yellow bucket.
        if r > 175 and g >= 145 and b < 95:
            out_pix[x,y] = palette[2]
            continue
        # Cream/off-white bucket.
        if r > 180 and g > 155 and b > 105:
            out_pix[x,y] = palette[4]
            continue
        # Nearest fallback.
        best = min(palette, key=lambda p: (r-p[0])**2 + (g-p[1])**2 + (b-p[2])**2)
        out_pix[x,y] = best
out_img.save(out)
print(out)
print(out_img.size)
print('unique', len(set(out_img.getdata())))
print(sorted('#%02x%02x%02x'%c for c in set(out_img.getdata())))
PY" in $HOME/Sites/BMH apps/BMH Institute
