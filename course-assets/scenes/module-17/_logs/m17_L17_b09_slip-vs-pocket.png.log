  {name: 'yellow', rgb: [255, 211, 1]},
  {name: 'cream', rgb: [255, 245, 199]},
  {name: 'white', rgb: [255, 255, 255]},
  {name: 'moneyGreen', rgb: [150, 204, 104]},
];
function pick(r, g, b) {
  const max = Math.max(r, g, b);
  const min = Math.min(r, g, b);
  if (max < 105) return palette[0].rgb;
  if (b > 165 && b > r + 30 && b > g + 25) return palette[1].rgb;
  if (g > r + 8 && g > b + 28 && r > 90 && r < 215 && b > 55 && b < 180) return palette[6].rgb;
  if (r > 205 && g < 165 && b < 90) return palette[2].rgb;
  if (r > 205 && g > 155 && b < 120) return palette[3].rgb;
  if (r > 230 && g > 225 && b > 215) return palette[5].rgb;
  if (r > 205 && g > 185 && b > 120) return palette[4].rgb;
  let best = palette[0].rgb;
  let bestD = Infinity;
  for (const {rgb} of palette) {
    const dr = r - rgb[0];
    const dg = g - rgb[1];
    const db = b - rgb[2];
    const d = dr * dr + dg * dg + db * db;
    if (d < bestD) { bestD = d; best = rgb; }
  }
  return best;
}
