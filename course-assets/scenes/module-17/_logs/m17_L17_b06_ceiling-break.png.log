exec
/bin/zsh -lc "node <<'NODE'
const sharp = require('sharp');

const input = '$HOME/.codex/generated_images/019f3d2d-6fa0-7122-a0a5-d1bfd78c60f5/ig_021ab403217a89e9016a4d1ac8cfb48190aefa7710a372b843.png';
const output = 'course-assets/scenes/module-17/m17_L17_b06_ceiling-break.png';
const palette = [
  [0x00, 0x00, 0x00],
  [0x62, 0xb3, 0xf3],
  [0xff, 0x7a, 0x00],
  [0xff, 0xd3, 0x01],
  [0xff, 0xf5, 0xc7],
  [0xff, 0xff, 0xff],
];

function nearest(r, g, b) {
  let best = palette[0];
  let bestDistance = Infinity;
  for (const color of palette) {
    const dr = r - color[0];
    const dg = g - color[1];
    const db = b - color[2];
    const distance = dr * dr + dg * dg + db * db;
    if (distance < bestDistance) {
      bestDistance = distance;
      best = color;
    }
  }
  return best;
}

(async () => {
  const { data, info } = await sharp(input)
    .resize(1600, 900, { fit: 'cover' })
    .removeAlpha()
    .raw()
    .toBuffer({ resolveWithObject: true });

  for (let i = 0; i < data.length; i += info.channels) {
    const [r, g, b] = nearest(data[i], data[i + 1], data[i + 2]);
    data[i] = r;
    data[i + 1] = g;
    data[i + 2] = b;
  }

  await sharp(data, { raw: { width: info.width, height: info.height, channels: info.channels } })
    .png({ compressionLevel: 9, adaptiveFiltering: false })
    .toFile(output);
})();
NODE" in $HOME/Sites/BMH apps/BMH Institute
