const sharp = require('sharp');
const source = '$HOME/.codex/generated_images/019f3d20-48ae-7a12-9822-7f0586ac091a/ig_0cb483d5d95e95bc016a4d172ab8f88191b946260004c7a614.png';
const dest = 'course-assets/scenes/module-17/m17_L17_b08_funnel.png';
const palette = [
  [0x62, 0xb3, 0xf3], // cornflower blue
  [0x00, 0x00, 0x00], // black
  [0xff, 0x7a, 0x00], // orange
  [0xff, 0xd3, 0x01], // yellow
  [0xff, 0xf5, 0xc7], // cream
  [0xff, 0xff, 0xff], // white
];
const blue = palette[0];
const dist2 = (a, b) => {
  const dr = a[0] - b[0];
  const dg = a[1] - b[1];
  const db = a[2] - b[2];
  return dr * dr + dg * dg + db * db;
};
const nearest = (rgb) => {
  const [r, g, b] = rgb;
  // Force generated background and soft blue shadow noise to the exact course blue.
  if (b >= 180 && g >= 120 && r <= 155 && b - r >= 45 && b - g >= 10) return blue;
  // Preserve outlines as solid black before nearest-color mapping can turn edge antialiasing gray.
  if (r <= 70 && g <= 70 && b <= 70) return palette[1];
  let best = palette[0];
  let bestD = Infinity;
  for (const color of palette) {
    const d = dist2(rgb, color);
    if (d < bestD) {
      best = color;
      bestD = d;
    }
  }
  return best;
};
(async () => {
  const { data, info } = await sharp(source)
    .resize(1600, 900, { fit: 'fill' })
    .removeAlpha()
    .raw()
    .toBuffer({ resolveWithObject: true });

  for (let i = 0; i < data.length; i += info.channels) {
    const mapped = nearest([data[i], data[i + 1], data[i + 2]]);
    data[i] = mapped[0];
    data[i + 1] = mapped[1];
    data[i + 2] = mapped[2];
  }

  await sharp(data, { raw: { width: info.width, height: info.height, channels: info.channels } })
    .png({ compressionLevel: 9, adaptiveFiltering: false })
    .toFile(dest);
  console.log(dest);
})();
