from PIL import Image, ImageOps
from pathlib import Path

src = Path('$HOME/.codex/generated_images/019f3d35-8a10-70a3-9ace-b81892dcb3cf/ig_025621dc139c69f5016a4d1ce8bbc48195bd3b7ea86c357a38.png')
out = Path('course-assets/scenes/module-17/m17_L17_b07_credit-loop.png')

palette = [
    (0x62, 0xb3, 0xf3),  # cornflower blue
    (0xff, 0xd3, 0x01),  # yellow
    (0xff, 0x7a, 0x00),  # orange
    (0xff, 0xf5, 0xc7),  # cream
    (0xff, 0xff, 0xff),  # white
    (0x00, 0x00, 0x00),  # black
]

img = Image.open(src).convert('RGB')
img = ImageOps.fit(img, (1600, 900), method=Image.Resampling.LANCZOS, centering=(0.5, 0.5))
px = img.load()
for y in range(img.height):
    for x in range(img.width):
        r, g, b = px[x, y]
        nearest = min(palette, key=lambda c: (r-c[0])**2 + (g-c[1])**2 + (b-c[2])**2)
        px[x, y] = nearest
out.parent.mkdir(parents=True, exist_ok=True)
img.save(out, format='PNG', optimize=True)
print(out)
PY" in $HOME/Sites/BMH apps/BMH Institute
