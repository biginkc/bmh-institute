exec
/bin/zsh -lc "python3 - <<'PY'
from PIL import Image
from pathlib import Path
src = Path('course-assets/scenes/module-17/m17_L17_b03_ramp-calendar.png')
out = Path('/tmp/m17_L17_b03_ramp-calendar-flat.png')
im = Image.open(src).convert('RGB')
pixels = im.load()
BG = (98, 179, 243)       # #62b3f3
BLACK = (0, 0, 0)
CREAM = (255, 248, 214)
WHITE = (255, 255, 246)
YELLOW = (255, 211, 22)
ORANGE = (255, 125, 0)
GREEN = (142, 193, 94)

w, h = im.size
for y in range(h):
    for x in range(w):
        r, g, b = pixels[x, y]
        # Remove blue background gradients and generated cast-shadow pixels.
        if b >= 175 and g >= 120 and r <= 135 and b >= r + 70 and b >= g + 20:
            pixels[x, y] = BG
            continue
        # Hard black linework, including antialias and generated dark edges.
        if max(r, g, b) < 95 or (r < 65 and g < 75 and b < 85):
            pixels[x, y] = BLACK
            continue
        # Money green is allowed only on bank notes.
        if g > r + 18 and g >= b + 5 and r >= 70 and b <= 180:
            pixels[x, y] = GREEN
            continue
        # Orange calendar bar and envelope accents.
        if r >= 185 and 55 <= g <= 170 and b <= 95:
            pixels[x, y] = ORANGE
            continue
        # Yellow progress squares and rings.
        if r >= 185 and g >= 135 and b <= 95:
            pixels[x, y] = YELLOW
            continue
        # Warm paper fills. Keep the brightest interiors slightly white.
        if r >= 170 and g >= 160 and b >= 115:
            if r >= 238 and g >= 235 and b >= 220:
                pixels[x, y] = WHITE
            else:
                pixels[x, y] = CREAM
            continue
        # Any leftover mid-blue from soft shadow becomes background.
        if b > g and b > r and g > 90:
            pixels[x, y] = BG
            continue
        # Snap remaining off-palette antialiases to the closest approved color.
        palette = (BG, BLACK, CREAM, WHITE, YELLOW, ORANGE, GREEN)
        pixels[x, y] = min(palette, key=lambda c: (r-c[0])**2 + (g-c[1])**2 + (b-c[2])**2)

im.save(out)
print(out)
