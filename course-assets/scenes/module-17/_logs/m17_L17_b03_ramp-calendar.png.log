/bin/zsh -lc "python3 - <<'PY'
from PIL import Image
from pathlib import Path
from collections import deque, Counter
src = Path('/tmp/m17_L17_b03_ramp-calendar-flat.png')
out = Path('/tmp/m17_L17_b03_ramp-calendar-flat-clean.png')
im = Image.open(src).convert('RGB')
w, h = im.size
px = im.load()
YELLOW = (255, 211, 22)
ORANGE = (255, 125, 0)
GREEN = (142, 193, 94)
BLACK = (0, 0, 0)
BG = (98, 179, 243)
CREAM = (255, 248, 214)
WHITE = (255, 255, 246)

def neighbors4(x, y):
    if x: yield x - 1, y
    if x + 1 < w: yield x + 1, y
    if y: yield x, y - 1
    if y + 1 < h: yield x, y + 1

def local_replacement(points):
    counts = Counter()
    pointset = set(points)
    for x, y in points:
        for yy in range(max(0, y - 2), min(h, y + 3)):
            for xx in range(max(0, x - 2), min(w, x + 3)):
                if (xx, yy) not in pointset:
                    c = px[xx, yy]
                    if c "'!= YELLOW:
                        counts[c] += 1
    if counts:
        return counts.most_common(1)[0][0]
    return WHITE

seen = set()
for y in range(h):
    for x in range(w):
        if (x, y) in seen or px[x, y] != YELLOW:
            continue
        q = deque([(x, y)])
        seen.add((x, y))
        comp = []
        while q:
            p = q.popleft()
            comp.append(p)
            for n in neighbors4(*p):
                if n not in seen and px[n] == YELLOW:
                    seen.add(n)
                    q.append(n)
        if len(comp) < 80:
            repl = local_replacement(comp)
            for p in comp:
                px[p] = repl

# One more pass removes single-pixel leftovers in paper/background.
for y in range(1, h - 1):
    for x in range(1, w - 1):
        c = px[x, y]
        if c in (YELLOW, ORANGE, GREEN, BLACK):
            same = 0
            for yy in range(y - 1, y + 2):
                for xx in range(x - 1, x + 2):
                    same += px[xx, yy] == c
            if same <= 2:
                counts = Counter(px[xx, yy] for yy in range(y - 1, y + 2) for xx in range(x - 1, x + 2) if (xx, yy) != (x, y))
                px[x, y] = counts.most_common(1)[0][0]

im.save(out)
print(out)
