from PIL import Image
from pathlib import Path
src = Path('$HOME/.codex/generated_images/019f3bb9-5641-7c43-ac57-dfbc5edec974/ig_0c07cd501bd0fec6016a4cbc29908c81958bb8391d60a1ab24.png')
out = Path('course-assets/scenes/module-17/m17_L17_b03_ramp-calendar.png')
BG = (98, 179, 243)
BLACK = (0, 0, 0)
CREAM = (255, 248, 214)
WHITE = (255, 255, 246)
YELLOW = (255, 211, 22)
ORANGE = (255, 125, 0)
GREEN = (142, 193, 94)
palette = (BG, BLACK, CREAM, WHITE, YELLOW, ORANGE, GREEN)

im = Image.open(src).convert('RGB').resize((1600, 900), Image.Resampling.LANCZOS)
px = im.load()
w, h = im.size
for y in range(h):
    for x in range(w):
        r, g, b = px[x, y]
        if b >= 170 and g >= 120 and r <= 140 and b >= r + 60 and b >= g + 15:
            px[x, y] = BG
        elif max(r, g, b) < 100 or (r < 75 and g < 85 and b < 95):
            px[x, y] = BLACK
        elif g > r + 15 and g >= b + 2 and r >= 70 and b <= 190:
            px[x, y] = GREEN
        elif r >= 185 and 55 <= g <= 175 and b <= 105:
            px[x, y] = ORANGE
        elif r >= 180 and g >= 135 and b <= 120:
            px[x, y] = YELLOW
        elif r >= 170 and g >= 155 and b >= 115:
            px[x, y] = WHITE if (r >= 238 and g >= 232 and b >= 215) else CREAM
        else:
            px[x, y] = min(palette, key=lambda c: (r-c[0])**2 + (g-c[1])**2 + (b-c[2])**2)

im.save(out)
print(out)
