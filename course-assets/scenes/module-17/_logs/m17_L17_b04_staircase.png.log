exec
/bin/zsh -lc "python3 - <<'PY'
from PIL import Image
from pathlib import Path

src = Path('$HOME/.codex/generated_images/019f3bc2-90c6-7611-8fd5-a3e0fed6b389/ig_08ea22047f176614016a4cbe68452c8195a835ce0a6bfd98e2.png')
out = Path('course-assets/scenes/module-17/m17_L17_b04_staircase.png')

palette = [
    (98, 179, 243),   # cornflower blue #62b3f3
    (0, 0, 0),        # black outlines
    (255, 211, 1),    # sunflower yellow
    (255, 245, 199),  # pale cream
    (148, 199, 96),   # money green only for cash
]

im = Image.open(src).convert('RGB').resize((1600, 900), Image.Resampling.LANCZOS)
pix = im.load()
for y in range(im.height):
    for x in range(im.width):
        r, g, b = pix[x, y]
        best = min(palette, key=lambda c: (r - c[0]) ** 2 + (g - c[1]) ** 2 + (b - c[2]) ** 2)
        pix[x, y] = best

out.parent.mkdir(parents=True, exist_ok=True)
im.save(out, format='PNG')
print(out)
PY" in $HOME/Sites/BMH apps/BMH Institute
