from PIL import Image
from pathlib import Path
src = Path('$HOME/.codex/generated_images/019f45ac-6398-7e73-9fdf-75b64ca701f2/ig_0414954081f51566016a4f47d9ce348197a8970d5dbea6682c.png')
out = Path('course-assets/scenes/module-17/m17_L17_b05_adjustable-scorecard.png')
img = Image.open(src).convert('RGB').resize((1600, 900), Image.Resampling.LANCZOS)
palette = [
    (0x62, 0xb3, 0xf3),  # cornflower blue
    (0xff, 0xd4, 0x14),  # yellow
    (0xff, 0x7a, 0x00),  # orange
    (0xff, 0xf4, 0xc4),  # cream
    (0xff, 0xff, 0xff),  # white
    (0x00, 0x00, 0x00),  # black
]
px = img.load()
for y in range(img.height):
    for x in range(img.width):
        r, g, b = px[x, y]
        best = min(palette, key=lambda c: (r-c[0])**2 + (g-c[1])**2 + (b-c[2])**2)
        px[x, y] = best
out.parent.mkdir(parents=True, exist_ok=True)
img.save(out, format='PNG', optimize=True)
print(out)
PY" in $HOME/Sites/BMH apps/BMH Institute
