python3 - <<'PY'
from PIL import Image
from pathlib import Path

path = Path('$HOME/Sites/BMH apps/BMH Institute/course-assets/scenes/module-13/m13_L13A_b12_money-table.png')
img = Image.open(path).convert('RGBA')
palette = [
    (98, 179, 243),   # cornflower blue background
    (0, 0, 0),        # black outlines/features
    (255, 255, 255),  # white
    (255, 248, 214),  # cream
    (255, 211, 0),    # yellow
    (255, 122, 0),    # orange
]

def is_background(r, g, b):
    return b >= 135 and g >= 85 and r <= 145 and (b - r) >= 50 and (b - g) >= 15

def dist2(c, p):
    return sum((c[i] - p[i]) ** 2 for i in range(3))

out = Image.new('RGBA', img.size, (98, 179, 243, 255))
pixels = img.load()
out_pixels = out.load()
for y in range(img.height):
    for x in range(img.width):
        r, g, b, a = pixels[x, y]
        if a == 0 or is_background(r, g, b):
            out_pixels[x, y] = (98, 179, 243, 255)
            continue
        # Force near-black strokes and facial marks to true black.
        if r < 80 and g < 80 and b < 80:
            out_pixels[x, y] = (0, 0, 0, 255)
            continue
        # Keep very light faces/hands white unless they are warm cream clothing.
        if r > 238 and g > 238 and b > 232 and abs(r - g) < 16:
            out_pixels[x, y] = (255, 255, 255, 255)
            continue
        nearest = min(palette[1:], key=lambda p: dist2((r, g, b), p))
        out_pixels[x, y] = (*nearest, 255)

out.save(path, format='PNG')
PY
