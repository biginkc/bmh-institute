const sharp = require(\"sharp\");
const src = \"$HOME/.codex/generated_images/019f3b70-c03e-7f90-84d8-df5d1d36491f/ig_02e19bc0f1132f71016a4ca8af0eec81959e45e5fc600c71dc.png\";
const out = \"course-assets/scenes/module-13/m13_L13A_b10_attribution-pipeline.png\";
const palette = [
  [0x62, 0xb3, 0xf3],
  [0xff, 0xd3, 0x10],
  [0xff, 0x7a, 0x00],
  [0xff, 0xf7, 0xde],
  [0xff, 0xff, 0xff],
  [0x11, 0x11, 0x11],
];
const dist = (a, b) => {
  const dr = a[0] - b[0];
  const dg = a[1] - b[1];
  const db = a[2] - b[2];
  return dr * dr + dg * dg + db * db;
};
(async () => {
  const { data, info } = await sharp(src)
    .resize(1600, 900, { fit: \"fill\" })
    .removeAlpha()
    .raw()
    .toBuffer({ resolveWithObject: true });
  for (let i = 0; i < data.length; i += info.channels) {
    const px = [data[i], data[i + 1], data[i + 2]];
    let best = palette[0];
    let bestScore = Infinity;
    for (const color of palette) {
      const score = dist(px, color);
      if (score < bestScore) {
        best = color;
        bestScore = score;
      }
    }
    data[i] = best[0];
    data[i + 1] = best[1];
    data[i + 2] = best[2];
  }
  await sharp(data, { raw: { width: 1600, height: 900, channels: info.channels } })
    .png({ compressionLevel: 9, palette: false })
    .toFile(out);
})();
'" in $HOME/Sites/BMH apps/BMH Institute
