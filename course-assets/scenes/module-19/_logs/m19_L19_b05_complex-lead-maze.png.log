  fi
}

gen_generic() {
  local file="$1"
  local desc="$2"
  local log="$LOG/$file.log"
  echo "=== GEN $file ==="
  {
    echo "Generate one image with gpt-image-2 and save it to $OUT/$file (PNG, 1600x900). Match the attached BMH course doodle references exactly. COMPOSITION: $desc $STYLE NEGATIVE: no people, no characters, no Andrea narrator, no Priya, no skin-tone colors, no readable text, no logos, no watermarks, no realistic UI, no decorative filler, no clutter, no clipped subject."
  } | codex exec \
    -i "$D/style-ref-1.png" \
    -i "$D/style-ref-2.png" \
    -i "$D/cast-board.png" \
    -i "$D/object-board.png" \
    --skip-git-repo-check \
    --sandbox workspace-write \
    > "$log" 2>&1

  if [ -f "$OUT/$file" ]; then
    echo "OK $file"
  else
    echo "MISSING $file (see $log)" >&2
    return 1
  fi
}

run_beat() {
  case "$1" in
    b02)
      gen_priya "m19_L19_b02_foundation-conveyor.png" "Conveyor-belt qualification machine scene. A simple conveyor belt runs left to right through a friendly boxy machine. On the left, a messy raw lead card enters the machine: rough-edged blank paper, loose blank notes, question-mark-like abstract shapes without real punctuation marks if possible, unorganized stack. On the right, a clean qualified lead packet exits: neat blank folder, organized blank rows, check boxes with simple check marks, ready tray. Priya stands beside the machine operating it, proud but focused. EXACTLY ONE PERSON. The machine transformation must be obvious even with no words." ;;
    b03)
      gen_priya "m19_L19_b03_clean-file-hug.png" "Clean-file handoff scene. Priya lovingly hugs a tidy cream folder/lead file against her chest like it is precious. The folder is visibly clean and complete: neatly stacked blank papers peeking out, blank checklist tabs, a small blank ready tray nearby. Sweet, warm, work-focused affection for the clean file. No hearts, no sparkles, no decorative marks. EXACTLY ONE PERSON." ;;
    b05)
      gen_priya "m19_L19_b05_complex-lead-maze.png" "Complex lead maze scene. Priya is inside a large simple maze drawn with thick cream/yellow maze walls on cornflower blue, seen from a slightly elevated flat doodle angle. She holds a small blank map and navigates toward a visible exit. Inside the maze are three blank sign plaques or empty label spaces placed at different turns where code-rendered labels will later appear. The maze must read as complicated but not cluttered. EXACTLY ONE PERSON. No readable text on the signs." ;;
    b06)
      gen_priya_crowd "m19_L19_b06_deal-conference.png" "Conference-stage deal-closer scene. Priya stands on a stage presenting to a packed but simple doodle audience. Behind her is a large blank presentation screen with a clear visual flow made of blank cards and arrows: offer packet card, terms sliders/card, negotiation table icon, signed contract icon. The screen contains no words or letters. Audience members are simple small doodle heads/bodies in rows, flat white/cream faces, no details. Priya is confident on stage with headset/headband identity. Keep the scene professional, not motivational-poster. Many audience figures are allowed but simple and not detailed." ;;
    b08)
      gen_priya "m19_L19_b08_priya-coaching.png" "Priya coaching teammate scene. Priya helps a second headset-wearing teammate at a computer. Priya stands or sits beside the teammate, pointing gently at a blank computer screen or guiding their hand near the keyboard. The teammate wears a headset and is clearly learning. The workstation has a blank monitor with blank rows/cards only, no text. The scene must read as practical coaching and team performance support. EXACTLY TWO PEOPLE: Priya plus one teammate. $TEAMMATE" ;;
    b10)
      gen_generic "m19_L19_b10_promotion-scorecard.png" "Promotion/readiness scorecard close-up scene. A large clean scorecard or clipboard fills most of the frame on a simple desk, with several blank checklist rows, blank checkbox squares, a small call-quality waveform icon, a blank CRM card icon, and a blank next-action arrow icon. This is the scorecard close-up that Andrea will read over later. The scorecard must look important and readable as criteria while containing no words, letters, or numbers. EXACTLY ZERO PEOPLE." ;;
    all)
      typeset -a pids
      for b in b02 b03 b05 b06 b08 b10; do
        zsh "$SCRIPT_PATH" "$b" &
        pids+=($!)
      done
      fail=0
      for pid in "${pids[@]}"; do
        wait "$pid" || fail=1
      done
      exit "$fail"
      ;;
    *)
      echo "usage: $0 {b02|b03|b05|b06|b08|b10|all}" >&2
      return 2
      ;;
  esac
}

run_beat "${1:-}"

